print("=== ระบบสั่งซื้อสินค้า ===")

# 1. เลือกสินค้าและจำนวน
product = input("กรุณาเลือกสินค้า: ")
price = float(input("ราคาสินค้า: "))
quantity = int(input("จำนวนสินค้า: "))

# 2. คำนวณราคารวม
total = price * quantity
print("ราคารวม =", total, "บาท")

# 3. รับเงินและตรวจสอบ
money = float(input("รับเงินจากลูกค้า: "))

if money >= total:
    change = money - total
    print("ชำระเงินสำเร็จ")
    print("เงินทอน =", change, "บาท")
else:
    print("เงินไม่เพียงพอ")
    print("กรุณาชำระเงินเพิ่ม", total - money, "บาท")

