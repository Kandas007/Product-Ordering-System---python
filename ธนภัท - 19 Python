# ฟังก์ชันที่ 1 : คำนวณราคารวม
def คำนวณราคารวม(ราคา, จำนวน):
    return ราคา * จำนวน


# ฟังก์ชันที่ 2 : ตรวจสอบเงินและเงินทอน
def ตรวจสอบเงิน(เงิน, ราคารวม):
    if เงิน >= ราคารวม:
        เงินทอน = เงิน - ราคารวม
        return "ชำระเงินสำเร็จ", เงินทอน
    else:
        return "เงินไม่เพียงพอ", 0


# โปรแกรมหลัก
while True:
    print("\n=== ระบบคำนวณราคาสินค้า ===")

    ราคา = float(input("ราคาสินค้า: "))
    จำนวน = int(input("จำนวนสินค้า: "))

    # เรียกใช้ฟังก์ชันที่ 1
    ราคารวม = คำนวณราคารวม(ราคา, จำนวน)
    print("ราคารวม =", ราคารวม, "บาท")

    เงิน = float(input("จำนวนเงินที่จ่าย: "))

    # เรียกใช้ฟังก์ชันที่ 2
    ผลลัพธ์, เงินทอน = ตรวจสอบเงิน(เงิน, ราคารวม)

    print(ผลลัพธ์)

    if เงิน >= ราคารวม:
        print("เงินทอน =", เงินทอน, "บาท")

    # ถามว่าจะทำซ้ำหรือไม่
    ทำต่อ = input("ต้องการทำรายการต่อหรือไม่? (y/n): ")

    if ทำต่อ == "n":
        print("จบการทำงาน")
        break
